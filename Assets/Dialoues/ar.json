[
	{"text": "[red: رائع !]", "typing_speed": 0.05, "box_visible": false, "language" : "ar", "position": { "x": 30, "y": 200 }, "text_align": "center",},
	{"text": "حقا! رائع!",},
	{"text": "الان يمكننا الحديث",},
	{"text": "يا [red: صغيري]",},
	{"text": "اااااا", "typing_speed": 0.05, "language" : "ar" ,"box_visible": true, "position": { "x": 30, "y": 355 }, "text_align": "",},
	{"text": "مهلا مهلا! اين انا.\nلايمكنني رؤية شيئ سوا الظلام.",},
	{"text": "يقول الناس مرحبا عندما يرون شخص غريب.", "box_visible": false, "position": { "x": 30, "y": 200 }, "text_align": "center",},
	{"text": "عليا العثور على المخرج بسرعة.\n ليس لدي وقت اضيعه هنا.","box_visible": true, "position": { "x": 30, "y": 355 }, "text_align": "",},
	{"text": "اسمعني جيدا.", "box_visible": false, "position": { "x": 30, "y": 200 }, "text_align": "center",},
	{"text": "لطافتي مع البشر لها حدود.",},
	{"text": "املك القوة لمحوك انت و [red: اختك] .",},
	{"text": "اختي متواجدة هنا ايضااا ؟!","box_visible": true, "position": { "x": 30, "y": 355 }, "text_align": "",},
	{"text": "لما لااراها في اي مكان هنا؟",},
	{"text": "انها في مكان ما هنا.", "box_visible": false, "position": { "x": 30, "y": 200 }, "text_align": "center",},
	{"text": "هذا ليس موضوعنا الان.",},
	{"text": "لقد احضرتكما الى هنا لتخوضا مغامرة.",},
	{"text": "كل شيئ هنا حقيقي.",},
	{"text": "هذا يبدو خطيرا ومرعبا للغاية.","box_visible": true, "position": { "x": 30, "y": 355 }, "text_align": "",},
	{"text": "لاتقلق هنالك قوى في هذا العالم.", "box_visible": false, "position": { "x": 30, "y": 200 }, "text_align": "center",},
	{"text": "يمكنك التعامل مع الخطر بنفسك.",},
	{"text": "وأيضا, سوف تساعدك اختك بقواها ايضا.",},
	{"text": "سوف اتدخل فقط عندما تناديني.",},
	{"text": "كيف يمكنني التواصل معك اذا كنت لااراك؟","box_visible": true, "position": { "x": 30, "y": 355 }, "text_align": "",},
	{"text": "ساستطيع سماعك تناديني سيدي في الظلام", "box_visible": false, "position": { "x": 30, "y": 200 }, "text_align": "center",},
	{"text": "لن اعطيك تفاصيل اكثر من هذا.",},
	{"text": "هل انت مستعد لبداية رحلتك؟", "choices": ["نعم", "نعم"], "choices_layout": "vertical",},
	{"text": "رحلتك تبدأ الان.",},
	
	
	
